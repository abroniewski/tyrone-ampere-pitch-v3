    "border": {
      "thin": "1px"
    },
    "triangleCue": {
      "width": "0.48rem",
      "height": "0.56rem",
      "direction": "right"
    },
    "heroMediaClip": "polygon(24% 0, 100% 0, 100% 82%, 63% 100%, 0 100%, 18% 50%)",
    "campaignMediaClip": "polygon(0 12%, 86% 0, 100% 72%, 76% 100%, 0 92%)"
  },
  "motion": {
    "official": {
      "libraries": ["Lenis", "Splitting.js", "Alpine.js", "Splide", "InfiniteMarquee", "countUp.js"],
      "scroll": {
        "engine": "Lenis",
        "duration": 1.2,
        "easing": "exponential-out approximation in app.js"
      },
      "inView": {
        "class": "inview",
        "rootMargin": "-100px"
      },
      "textSplitting": {
        "charStagger": "calc(var(--char-index) * 0.01s)",
        "lineStagger": "calc(var(--line-index) * 0.25s)"
      },
      "confidence": "high"
    },
    "easing": {
      "revealPrimary": "cubic-bezier(0.4, 0.5, 0, 1)",
      "revealSecondary": "cubic-bezier(0.25, 0.1, 0.25, 1)",
      "outExpo": "cubic-bezier(0.16, 1, 0.3, 1)",
      "inOut": "cubic-bezier(0.76, 0, 0.24, 1)",
      "linear": "linear",
      "ui": "ease"
    },
    "duration": {
      "ui": "250ms",
      "fast": "180ms",
      "base": "420ms",
      "fade": "1000ms",
      "charReveal": "1200ms",
      "lineReveal": "1200ms",
      "fadeline": "1500ms",
      "slow": "900ms",
      "reveal": "1100ms",
      "cardFill": "650ms",
      "countUp": "5000ms"
    },
    "reveal": {
      "distance": "40px",
      "threshold": 0.12,
      "once": true
    },
    "stagger": {
      "charStep": "10ms",
      "lineStep": "250ms",
      "headlineMin": "10ms",
      "headlineMax": "10ms"
    },
    "parallax": {
      "minFactor": 0.04,
      "maxFactor": 0.08,
      "allowedTargets": [
        "large background shapes",
        "large media"
      ],
      "forbiddenTargets": [
        "body copy",
        "form controls"
      ]
    },
    "marquee": {
      "loopMin": "18s",
      "loopMax": "28s",
      "pauseOnHoverRecommended": true
    },
    "reducedMotion": {
      "disableParallax": true,
      "stopMarquee": true,
      "revealImmediately": true,
      "preserveStates": true
    }
  },
  "zIndex": {
    "base": 1,
    "sticky": 20,
    "header": 40,
    "menu": 60,
    "preloader": 100
