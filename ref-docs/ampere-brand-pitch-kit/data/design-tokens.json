        "f--p-small": { "designPx": 14, "weight": 400, "lineHeight": 1.4 },
        "f--callout": { "designPx": 48, "weight": 300, "lineHeight": 1.1 },
        "f--testimonial": { "designPx": 30, "weight": 300, "lineHeight": 1.1 },
        "f--tag": { "designPx": 15, "weight": 400, "case": "uppercase" }
