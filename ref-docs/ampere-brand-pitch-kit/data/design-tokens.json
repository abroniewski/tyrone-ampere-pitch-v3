      "confidence": "high"
    },
    "browserValidated": {
      "capturedAt": "2026-07-16",
      "viewports": {
        "1440": {
          "heroHeadline": { "fontSize": "100px", "fontWeight": "300", "lineHeight": "95px", "color": "#FFFFFF" },
          "navLink": { "fontSize": "12px", "fontWeight": "500", "textTransform": "uppercase" },
          "bodyCopy": { "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "color": "#C2C2C2" }
