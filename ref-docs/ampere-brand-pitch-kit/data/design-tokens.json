    "2xs": "0.375rem",
    "xs": "0.625rem",
    "sm": "0.875rem",
    "md": "1.25rem",
    "lg": "2rem",
    "xl": "3rem",
    "2xl": "4.5rem",
    "3xl": "7rem",
    "4xl": "10rem"
