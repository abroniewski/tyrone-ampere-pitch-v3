        "breakpoint": "min-width: 1024px",
        "display": "inline",
        "fontSizeDesignPx": 12,
        "fontWeight": 500,
        "textTransform": "uppercase",
        "transitionDuration": "250ms"
      },
      "mobile": {
        "menuTriggerSelector": "header .menu",
        "navPanelSelector": "header nav.active",
        "linkSelector": "header nav ul.f--navigation a",
        "breakpoint": "max-width: 1023px",
        "fontSizeDesignPx": 20,
        "fontWeight": 400,
        "textTransform": "uppercase",
        "panelBackground": "#000000",
        "itemBorderColor": "#737373"
      },
      "confidence": "high"
    },
