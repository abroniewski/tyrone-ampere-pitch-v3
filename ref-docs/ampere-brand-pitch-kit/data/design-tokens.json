          "navLink": { "fontSize": "19.90px", "fontWeight": "400", "textTransform": "uppercase", "requiresMenuOpen": true },
          "bodyCopy": { "fontSize": "14.92px", "lineHeight": "20.89px" }
        }
      },
      "confidence": "high"
