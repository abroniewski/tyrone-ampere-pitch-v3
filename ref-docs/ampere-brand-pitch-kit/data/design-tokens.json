    "gridGap": "clamp(1rem, 2vw, 2.5rem)",
    "headerHeight": "5.25rem",
    "columns": 12,
    "recommendedTextMeasure": "34rem",
    "breakpoints": {
      "small": "480px",
      "medium": "768px",
      "large": "1024px",
      "wide": "1440px",
      "ultra": "1888px"
