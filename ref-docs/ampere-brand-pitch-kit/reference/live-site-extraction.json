    "computedAt1440": {
      "f--h1": "100px",
      "f--h1-small": "62px",
      "f--h2": "15px",
      "f--h3": "100px",
      "f--h3-small": "48px",
      "f--h4": "30px",
      "f--navigation": "12px",
      "f--p": "16px",
      "f--p-small": "14px",
      "f--callout": "48px",
      "f--testimonial": "30px",
      "f--tag": "15px"
    },
    "computedAt1800": {
      "f--h1": "125px",
      "f--h3": "125px"
    },
    "computedAtMobile392": {
      "f--h1": "59.69px",
      "f--h1-cssRule": "60px",
      "f--h1-small": "30px",
      "f--h3": "40px",
      "f--navigation-mobile": "19.90px"
    }
  },
  "navigation": {
    "desktop": {
      "linkSelector": "header nav ul.f--navigation a",
      "listSelector": "header nav ul.f--navigation",
      "breakpoint": "min-width: 1024px",
      "menuTriggerHidden": "header .menu { display: none }",
      "fontClass": "f--navigation",
      "designPx": 12,
      "fontWeight": 500,
      "textTransform": "uppercase",
      "transitionDuration": "250ms",
      "browserValidatedAt1440": {
        "fontSize": "12px",
        "fontWeight": "500"
      }
    },
    "mobile": {
      "menuTriggerSelector": "header .menu",
      "navPanelSelector": "header nav",
      "navPanelActiveSelector": "header nav.active",
      "linkSelector": "header nav ul.f--navigation a",
      "closeSelector": "header nav .close",
      "breakpoint": "max-width: 1023px",
      "panelDisplayWhenActive": "flex",
      "panelBackground": "#000000",
      "itemBorderColor": "#737373",
      "fontSizeRule": "calc(20 / var(--size) * var(--size-end))",
      "fontWeight": 400,
      "textTransform": "uppercase",
      "requiresMenuOpenForCapture": true,
      "browserValidatedAt390": {
        "fontSize": "19.898px",
        "fontWeight": "400",
        "navPanelClasses": ["active"]
      }
    },
    "items": ["About", "Portfolio", "Approach", "Insights", "Contact"]
  },
  "colors": {
    "observedInThemeCss": {
      "background": "#000000",
      "bodyText": "#FFFFFF",
      "silver": "#C2C2C2",
      "accentBlue": "#3D6DFF",
      "metaThemeBlue": "#0340F8",
      "mutedGray": "#737373",
      "borderLight": "#EEEEEE"
    },
    "notes": [
      "Accent blue #3D6DFF is used for buttons, borders, marquee bullets, and slider hover fills.",
      "Meta theme-color #0340F8 may be the canonical brand blue; confirm against approved brand guidelines."
    ]
  },
  "motion": {
    "libraries": [
      "Lenis smooth scroll",
      "Splitting.js text splitting",
      "Alpine.js component layer",
      "Splide carousel",
      "InfiniteMarquee",
      "countUp.js"
    ],
    "scroll": {
      "engine": "Lenis",
      "duration": 1.2,
      "easing": "Math.min(1, 1.001 - Math.pow(2, -10 * t))",
      "smoothWheel": true,
      "smoothTouch": false,
      "wheelMultiplier": 1,
      "infinite": false
    },
    "inView": {
      "triggerClass": "inview",
      "observerRootMargin": "-100px",
      "observeOnce": true
    },
    "easingCurves": {
      "revealPrimary": "cubic-bezier(0.4, 0.5, 0, 1)",
      "revealSecondary": "cubic-bezier(0.25, 0.1, 0.25, 1)",
      "uiFast": "ease",
      "pageIn": "ease-in"
    },
    "durations": {
      "ui": "250ms",
      "fade": "1000ms",
      "charReveal": "1200ms",
      "lineReveal": "1200ms",
      "fadeline": "1500ms",
      "headlineAccent": "1000ms",
      "headlineRule": "1500ms",
      "pageTransitionOut": "250ms",
      "pageTransitionIn": "250ms",
      "accordion": "500ms",
      "sliderHover": "250ms",
      "countUp": "5000ms"
    },
    "keyframes": {
      "down": {
        "from": "translateY(102%)",
        "to": "none",
        "duration": "1.2s",
        "easing": "cubic-bezier(0.4, 0.5, 0, 1)"
      },
      "fadedown": {
        "from": "translateY(25px), opacity 0",
        "to": "none, opacity 1",
        "duration": "1s",
        "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "fadeline": {
        "from": "translateY(105%)",
        "to": "none",
        "duration": "1.5s",
        "easing": "cubic-bezier(0.4, 0.5, 0, 1)"
      },
      "fadeup": {
        "from": "translateY(-25px), opacity 0",
        "to": "none, opacity 1",
        "duration": "1s",
        "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "fadeleft": {
        "from": "translateX(-25px), opacity 0",
        "to": "none, opacity 1",
        "duration": "1s",
        "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)",
        "mobileOverride": "translateY(25px) below 1023px"
      },
      "faderight": {
        "from": "translateX(25px), opacity 0",
        "to": "none, opacity 1",
        "duration": "1s",
        "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "fade": {
        "from": "opacity 0",
        "to": "opacity 1",
        "duration": "1s",
        "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "width": {
        "from": "width 0 or 1%",
        "to": "width 100%",
        "duration": "1s",
        "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "horizontal-marquee": {
        "timing": "linear infinite",
        "speedVariable": "--_speed"
      },
      "vertical-marquee": {
        "timing": "linear infinite",
        "speedVariable": "--_speed"
      },
      "animateIn": {
        "from": "opacity 0",
        "to": "opacity 1",
        "duration": "0.25s",
        "easing": "ease-in"
      }
    },
    "textSplitting": {
      "chars": {
        "initial": "translateY(110%)",
        "inViewAnimation": "down",
        "stagger": "calc(var(--char-index) * 0.01s)"
      },
      "lines": {
        "initial": "translateY(102%), opacity 0",
        "inViewAnimation": "fadedown",
        "stagger": "calc(var(--line-index) * 0.25s)"
      }
    },
    "utilityClasses": {
      "initialStates": [
        "t--fade",
        "t--fadedown",
        "t--fadeline",
        "t--fadeup",
        "t--fadeleft",
        "t--faderight"
      ],
      "delaysMs": [250, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500]
    },
    "marquee": {
      "component": "InfiniteMarquee",
      "defaultDuplicateCount": 2,
      "defaultPauseOnHover": true,
      "defaultDirection": "left",
      "speedFormula": "1500 * multiplier"
    },
    "parallax": {
      "attribute": "data-power",
      "defaultPower": 1,
      "method": "scroll-linked translateY on Alpine parallax component"
    },
    "header": {
      "scrollClassThreshold": 50,
      "hideOnScrollDown": true,
      "showOnScrollUp": true
    },
    "pageTransition": {
      "outClass": "animate-out",
      "outDuration": "250ms",
      "outProperty": "opacity"
    },
    "counterStagger": {
      "childDelay": "index / 8 seconds",
      "countUpStartDelay": "index / 8 * 1000 + 250 ms"
    }
  },
