{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Ampere Alliance live site extraction",
  "capturedAt": "2026-07-16",
  "source": {
    "homepage": "https://amperealliance.ca/",
    "globalCss": "https://amperealliance.ca/wp-content/themes/theme/assets/css/global.css?ver=1.0.35",
    "appJs": "https://amperealliance.ca/wp-content/themes/theme/assets/js/app.js?ver=1.0.35",
    "themeVersion": "1.0.35",
    "extractionMethod": "Public HTML, theme CSS/JS download, and Playwright browser validation. No font files copied."
  },
  "browserValidation": {
    "capturedAt": "2026-07-16",
    "reference": "manual-capture.json",
    "captureScript": "capture-live-site.mjs",
    "method": "Playwright Chromium headless at 1440, 1024, and 390 viewports"
  },
  "meta": {
    "themeColor": "#0340F8",
    "tileColor": "#0340F8",
    "title": "Ampere Alliance — The Next Generation of Power"
  },
  "fonts": {
    "familyName": "General Sans",
    "cssAlias": "G",
    "foundry": "Indian Type Foundry",
    "weights": [
      {
        "weight": 300,
        "file": "GeneralSans-Light.woff2",
        "url": "https://amperealliance.ca/wp-content/themes/theme/assets/fonts/GeneralSans-Light.woff2"
      },
      {
        "weight": 400,
        "file": "GeneralSans-Regular.woff2",
        "url": "https://amperealliance.ca/wp-content/themes/theme/assets/fonts/GeneralSans-Regular.woff2"
      },
      {
        "weight": 500,
        "file": "GeneralSans-Medium.woff2",
        "url": "https://amperealliance.ca/wp-content/themes/theme/assets/fonts/GeneralSans-Medium.woff2"
      }
    ],
    "stack": "\"G\", Helvetica, Arial, sans-serif",
    "smoothing": "antialiased",
    "ligatures": "none"
  },
  "sizingSystem": {
    "formula": "calc(N / var(--size) * var(--size-end))",
    "description": "Fluid pixel values scale from a reference artboard width to the current viewport.",
    "variables": {
      "--size": "Reference artboard width in px",
      "--size-end": "Target width, usually 100vw with an 1800px cap on very wide screens"
    },
    "breakpoints": [
      {
        "query": "default",
        "size": 1440,
        "sizeEnd": "100vw"
      },
      {
        "query": "min-width: 1800px",
        "size": 1440,
        "sizeEnd": "1800px"
      },
      {
        "query": "max-width: 1199px",
        "size": 1200,
        "sizeEnd": "100vw"
      },
      {
        "query": "max-width: 1023px",
        "size": 1024,
        "sizeEnd": "100vw"
      },
      {
        "query": "max-width: 767px",
        "size": 392,
        "sizeEnd": "100vw"
      }
    ],
    "hoverBreakpoint": "min-width: 1025px"
  },
